# General/Vercel Config
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
NODE_ENV=development

# Python Service Configuration
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_PORT=8000

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Frontend Configuration
# VITE_API_URL is intentionally NOT set - frontend uses relative paths
# In local dev, Vite proxy handles /api/* forwarding to localhost:5000
VITE_PYTHON_SERVICE_URL=http://localhost:8000

# Google Sheets DB Configuration
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
