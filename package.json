{
  "name": "smart-interview-portal",
  "version": "1.0.0",
  "description": "AI-powered Smart Interview Preparation Portal",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../python-service && pip install -r requirements.txt",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "python": "cd python-service && python -m uvicorn main:app --reload --port 8000",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\" \"npm run python\"",
    "build": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "interview",
    "preparation",
    "AI",
    "MERN",
    "resume"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
