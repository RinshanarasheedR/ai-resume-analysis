{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1",
      "service": "backend"
    },
    {
      "source": "/health",
      "destination": "/health",
      "service": "backend"
    },
    {
      "source": "/((?!api|health|assets|favicon\\.ico).*)",
      "destination": "/index.html",
      "service": "frontend"
    }
  ]
}
